{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrontFormUrl": "http://localhost:5174/neoformext/front/",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExternalNeoFormContext": "Server=MEA-23VYXL3;Database=ExternalNeoForm;User Id=ENC:AgJMj9OBB5Fx6uo9uo52Iw==;Password=ENC:/hTLT5ArFEVAd4HCndY54Q==;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Exceptions",
      "Serilog.Expressions"
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "NeoForm_Externe.Filters.DynamicApiKeyAuthFilter": "Debug",
        "NeoForm_Externe.Services.OidcService": "Debug",
        "NeoForm_Externe.Controllers.OidcController": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Integration.Elise.EliseSoapServiceFacade')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\ProgramData\\Archimed\\logs\\Integration.Elise.ExternalNeoForm.API-.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {MachineName} {ThreadId} [{Level:u5}] [{SourceContext}] {Message}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Integration.Elise.EliseSoapServiceFacade')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\ProgramData\\Archimed\\logs\\Integration.Elise.ExternalNeoForm.SOAP-.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {MachineName} {ThreadId} [{Level:u5}] [{SourceContext}] {Message}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 100
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ],
    "Properties": {
      "Application": "Integration.Elise.ExternalNeoForm"
    }
  },
  "NeoForm": {
    "X-api-key": "ENC:j9KW8UkEBxPNPNd2zibC72pJpDmVxHsMD2w880ZpkrXmaSclpeCuzlMauDvYQgTC"
  },
  "EmailAuth": {
