{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrontFormUrl": "http://localhost:5174/neoformext/front/",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExternalNeoFormContext": "Server=MEA-23VYXL3;Database=ExternalNeoForm;User Id=yassine;Password=12345678;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Exceptions",
      "Serilog.Expressions"
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "NeoForm_Externe.Filters.DynamicApiKeyAuthFilter": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Integration.Elise.EliseSoapServiceFacade')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\ProgramData\\Archimed\\logs\\Integration.Elise.ExternalNeoForm.API-.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {MachineName} {ThreadId} [{Level:u5}] [{SourceContext}] {Message}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Integration.Elise.EliseSoapServiceFacade')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\ProgramData\\Archimed\\logs\\Integration.Elise.ExternalNeoForm.SOAP-.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {MachineName} {ThreadId} [{Level:u5}] [{SourceContext}] {Message}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 100
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ],
    "Properties": {
      "Application": "Integration.Elise.ExternalNeoForm"
    }
  },
  "NeoForm": {
    "X-api-key": "72ee25d4-tyjf-2994-ocxk-29be8ea3fba6"
  },
  "Jwt": {
    "Authority": "http://localhost:8080/realms/NeoFormExt",
    "Audience": "NeoFormExt",
    "RequireHttpsMetadata": false
  }
}
